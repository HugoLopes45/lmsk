{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/await-thenable": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "complexity": [
      "error",
      {
        "max": 10
      }
    ]
  },
  "overrides": [
    {
      "files": ["test/core/guard.test.ts", "test/pi/e2e.test.ts"],
      "rules": {
        "typescript/unbound-method": "off"
      }
    },
    {
      "files": [
        "src/core/encoded.ts",
        "src/core/scanner.ts",
        "test/core/masker.test.ts",
        "test/core/pii-rules.test.ts",
        "test/core/shape.test.ts",
        "test/pi/extension.test.ts",
        "test/pi/leak-baseline.ts",
        "test/proxy/server.test.ts"
      ],
      "rules": {
        "typescript/no-misused-spread": "off"
      }
    },
    {
      "files": [
        "src/core/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/**",
                  "../**"
                ],
                "message": "The engine depends on no harness and no other module."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/pi/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../**",
                  "!../core/index.ts",
                  "!../formats/index.ts"
                ],
                "message": "An adapter imports no other adapter and uses only the public API of other modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/formats/**",
        "src/proxy/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/**",
                  "../**",
                  "!../core/index.ts"
                ],
                "message": "Formats and the proxy depend only on the public API of the engine, and on no harness."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/claude-code/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/**",
                  "../**",
                  "!../core/index.ts",
                  "!../formats/index.ts",
                  "!../proxy/index.ts"
                ],
                "message": "An adapter imports no harness SDK and no other adapter, and uses only the public API of other modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/cli/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@earendil-works/**",
                  "../**",
                  "!../core/index.ts",
                  "!../claude-code/index.ts"
                ],
                "message": "The CLI parses and dispatches only, through the public API of the Claude Code adapter."
              }
            ]
          }
        ]
      }
    }
  ]
}
