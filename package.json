{
  "name": "@hugolopes45/lmsk",
  "version": "0.3.0",
  "description": "Mask API keys, passwords and emails before Claude Code or the pi coding agent sends them to the LLM, and restore them in tool calls.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19"
  },
  "author": "HugoLopes45 (https://github.com/HugoLopes45)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HugoLopes45/lmsk.git"
  },
  "homepage": "https://hugolopes45.github.io/lmsk/",
  "bugs": {
    "url": "https://github.com/HugoLopes45/lmsk/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "claude-code",
    "coding-agent",
    "llm",
    "secrets",
    "api-keys",
    "mask",
    "redact",
    "redaction",
    "privacy",
    "pii",
    "dlp",
    "gitleaks"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "default": "./dist/public.js"
    }
  },
  "bin": {
    "lmsk": "./dist/cli/bin.js"
  },
  "pi": {
    "extensions": [
      "./dist/pi/extension.js"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/release.ts check && oxfmt --check src test scripts && oxlint --deny-warnings && tsc --noEmit && npm run build && vitest --run",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt src test scripts",
    "test": "npm run build && vitest --run",
    "release": "node scripts/release.ts prepare",
    "schema": "node scripts/write-schema.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.0.3",
    "@earendil-works/pi-coding-agent": "^1.0.3",
    "@types/node": "^22.19.0",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typebox": "^1.4.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
