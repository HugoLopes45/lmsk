# Allowlist: ignore everything, then re-include only public files.
/*
!/.github/
!/.gitignore
!/.oxlintrc.json
!/CHANGELOG.md
!/CONTRIBUTING.md
!/LICENSE
!/README.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.build.json
!/plugin/
!/schema/
!/scripts/
!/src/
!/test/

!/docs/
/docs/*
!/docs/brand/
!/docs/fonts/
!/docs/index.html
!/docs/CONFIGURATION.md
!/docs/GUIDE.md
!/docs/TROUBLESHOOTING.md
!/docs/claude-code.md
!/docs/pi.md

# Build output and local files, also inside re-included directories.
node_modules/
dist/
*.tsbuildinfo
*.log
.DS_Store
