{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/../dist/cli/bin.js",
              "hook",
              "claude"
            ],
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
